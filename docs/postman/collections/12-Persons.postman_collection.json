{
  "info": {
    "_postman_id": "persons-collection-v1",
    "name": "12 - Persons",
    "description": "Person management endpoints - Full CRUD operations for person detection module",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "List Persons",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/persons?per_page=15&page=1",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "persons"],
          "query": [
            {"key": "per_page", "value": "15"},
            {"key": "page", "value": "1"},
            {"key": "search", "value": "", "disabled": true},
            {"key": "sort_by", "value": "full_name", "disabled": true},
            {"key": "sort_order", "value": "asc", "disabled": true},
            {"key": "filter[gender]", "value": "M", "disabled": true},
            {"key": "filter[is_blacklisted]", "value": "false", "disabled": true},
            {"key": "filter[country_id]", "value": "1", "disabled": true}
          ]
        }
      }
    },
    {
      "name": "Show Person ",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/persons/{{person_uuid}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "persons", "{{person_uuid}}"]
        }
      }
    },
    {
      "name": "Create Person",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "POST",
        "header": [
          {"key": "Accept", "value": "application/json"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"full_name\": \"John Doe\",\n    \"social_name\": \"Johnny\",\n    \"birth_date\": \"1990-05-15\",\n    \"gender\": \"M\",\n    \"mother_name\": \"Jane Doe\",\n    \"father_name\": \"Jack Doe\",\n    \"country_id\": 1,\n    \"birth_city_id\": 3550308,\n    \"birth_state_id\": 35,\n    \"is_blacklisted\": false,\n    \"notes\": \"Test person record\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/persons",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "persons"]
        }
      }
    },
    {
      "name": "Update Person",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "PUT",
        "header": [
          {"key": "Accept", "value": "application/json"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"full_name\": \"John Smith\",\n    \"social_name\": \"Johnny\",\n    \"gender\": \"M\",\n    \"notes\": \"Updated person information\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/persons/{{person_uuid}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "persons", "{{person_uuid}}"]
        }
      }
    },
    {
      "name": " Delete Person (Soft)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "DELETE",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/persons/{{person_uuid}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "persons", "{{person_uuid}}"]
        }
      }
    },
    {
      "name": "Restore Person",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "POST",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/persons/{{person_uuid}}/restore",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "persons", "{{person_uuid}}", "restore"]
        }
      }
    },
    {
      "name": "Force Delete Person",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "DELETE",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/persons/{{person_uuid}}/force",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "persons", "{{person_uuid}}", "force"]
        }
      }
    }
  ],
  "variable": [
    {"key": "base_url", "value": "http://localhost:8000", "type": "string"},
    {"key": "person_uuid", "value": "", "type": "string"}
  ]
}
