{
  "info": {
    "_postman_id": "users-collection-v1",
    "name": "02 - Users",
    "description": "User management endpoints - Full CRUD operations",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "List Users",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/users?per_page=15&page=1",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "users"],
          "query": [
            {"key": "per_page", "value": "15"},
            {"key": "page", "value": "1"},
            {"key": "search", "value": "", "disabled": true},
            {"key": "sort_by", "value": "created_at", "disabled": true},
            {"key": "sort_order", "value": "desc", "disabled": true}
          ]
        }
      }
    },
    {
      "name": "Show User",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/users/{{user_uuid}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "users", "{{user_uuid}}"]
        }
      }
    },
    {
      "name": "Create User",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "POST",
        "header": [
          {"key": "Accept", "value": "application/json"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"New User\",\n    \"email\": \"newuser@example.com\",\n    \"password\": \"password123\",\n    \"password_confirmation\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/users",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "users"]
        }
      }
    },
    {
      "name": "Update User",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "PUT",
        "header": [
          {"key": "Accept", "value": "application/json"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Updated Name\",\n    \"email\": \"updated@example.com\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/users/{{user_uuid}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "users", "{{user_uuid}}"]
        }
      }
    },
    {
      "name": "Delete User (Soft)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "DELETE",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/users/{{user_uuid}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "users", "{{user_uuid}}"]
        }
      }
    },
    {
      "name": "Restore User",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "POST",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/users/{{user_uuid}}/restore",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "users", "{{user_uuid}}", "restore"]
        }
      }
    },
    {
      "name": "Force Delete User",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "DELETE",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/users/{{user_uuid}}/force",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "users", "{{user_uuid}}", "force"]
        }
      }
    }
  ],
  "variable": [
    {"key": "base_url", "value": "http://localhost:8000", "type": "string"}
  ]
}
