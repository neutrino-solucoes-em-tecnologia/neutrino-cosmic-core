        "method": "POST",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/regions/:uuid/restore",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "regions", ":uuid", "restore"],
