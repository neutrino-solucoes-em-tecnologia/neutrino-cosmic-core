{
  "info": {
    "_postman_id": "person-photos-collection-v1",
    "name": "17 - Person Photos",
    "description": "Person Photos management endpoints - Full CRUD operations with file upload",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "List Person Photos",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/person-photos?per_page=15&page=1",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "person-photos"],
          "query": [
            {"key": "per_page", "value": "15"},
            {"key": "page", "value": "1"},
            {"key": "search", "value": "", "disabled": true},
            {"key": "person_id", "value": "", "disabled": true},
            {"key": "photo_type", "value": "PROFILE", "disabled": true},
            {"key": "is_primary", "value": "true", "disabled": true},
            {"key": "sort_by", "value": "created_at", "disabled": true},
            {"key": "sort_order", "value": "desc", "disabled": true}
          ]
        }
      }
    },
    {
      "name": "Show Person Photo",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/person-photos/{{photo_uuid}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "person-photos", "{{photo_uuid}}"]
        }
      }
    },
    {
      "name": "Create Person Photo",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "POST",
        "header": [{"key": "Accept", "value": "application/json"}],
        "body": {
          "mode": "formdata",
          "formdata": [
            {"key": "person_id", "value": "1", "type": "text"},
            {"key": "photo_type", "value": "PROFILE", "type": "text"},
            {"key": "file", "type": "file", "src": ""},
            {"key": "description", "value": "Profile photo", "type": "text", "disabled": true},
            {"key": "capture_date", "value": "2026-01-22T10:30:00Z", "type": "text", "disabled": true},
            {"key": "capture_location", "value": "Main Office", "type": "text", "disabled": true},
            {"key": "is_primary", "value": "1", "type": "text", "disabled": true}
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/person-photos",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "person-photos"]
        }
      }
    },
    {
      "name": "Update Person Photo",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "PUT",
        "header": [
          {"key": "Accept", "value": "application/json"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"description\": \"Updated photo description\",\n    \"is_primary\": true\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/person-photos/{{photo_uuid}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "person-photos", "{{photo_uuid}}"]
        }
      }
    },
    {
      "name": "Delete Person Photo (Soft)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "DELETE",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/person-photos/{{photo_uuid}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "person-photos", "{{photo_uuid}}"]
        }
      }
    },
    {
      "name": "Restore Person Photo",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "POST",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/person-photos/{{photo_uuid}}/restore",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "person-photos", "{{photo_uuid}}", "restore"]
        }
      }
    },
    {
      "name": "Force Delete Person Photo",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "DELETE",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/person-photos/{{photo_uuid}}/force",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "person-photos", "{{photo_uuid}}", "force"]
        }
      }
    }
  ],
  "variable": [
    {"key": "base_url", "value": "http://localhost:8000", "type": "string"}
  ]
}
