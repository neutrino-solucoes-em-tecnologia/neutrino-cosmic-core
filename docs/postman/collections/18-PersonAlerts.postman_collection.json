  "item": [
    {
      "name": "List All Person Alerts",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{auth_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/person-alerts?per_page=15&filter[alert_level]=HIGH&filter[alert_status]=ACTIVE&sort=-alert_date",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "person-alerts"],
          "query": [
            {
              "key": "per_page",
              "value": "15",
              "description": "Items per page (1-100)"
            },
            {
              "key": "search",
              "value": "security",
              "description": "Search in title, description, location",
              "disabled": true
            },
            {
              "key": "filter[person_id]",
              "value": "1",
              "description": "Filter by person ID",
              "disabled": true
            },
            {
              "key": "filter[alert_level]",
              "value": "HIGH",
              "description": "LOW, MEDIUM, HIGH, CRITICAL"
            },
            {
              "key": "filter[alert_status]",
              "value": "ACTIVE",
              "description": "ACTIVE, ACKNOWLEDGED, RESOLVED, DISMISSED"
            },
            {
              "key": "sort",
              "value": "-alert_date",
              "description": "Sort by field (prefix - for desc)"
            }
          ]
        }
      },
      "response": []
    },
