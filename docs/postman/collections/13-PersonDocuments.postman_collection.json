{
  "info": {
    "_postman_id": "persons-documents-collection-v1",
    "name": "13 - Persons Documents",
    "description": "Persons document management endpoints - Full CRUD operations for identification documents",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "List Persons Documents",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/person-documents?per_page=15&page=1",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "person-documents"],
          "query": [
            {"key": "per_page", "value": "15"},
            {"key": "page", "value": "1"},
            {"key": "search", "value": "", "disabled": true},
            {"key": "sort_by", "value": "created_at", "disabled": true},
            {"key": "sort_order", "value": "desc", "disabled": true},
            {"key": "filter[document_type]", "value": "CPF", "disabled": true},
            {"key": "filter[person_id]", "value": "1", "disabled": true}
          ]
        }
      }
    },
    {
      "name": "Show Persons Document",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/person-documents/{{person_document_uuid}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "person-documents", "{{person_document_uuid}}"]
        }
      }
    },
    {
      "name": "Create Persons Document",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "POST",
        "header": [
          {"key": "Accept", "value": "application/json"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"person_id\": 1,\n    \"document_type\": \"CPF\",\n    \"document_number\": \"123.456.789-00\",\n    \"issuing_agency\": \"SSP-SP\",\n    \"issue_date\": \"2020-01-15\",\n    \"notes\": \"Main identification document\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/person-documents",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "person-documents"]
        }
      }
    },
    {
      "name": "Update Persons Document",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "PUT",
        "header": [
          {"key": "Accept", "value": "application/json"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"issuing_agency\": \"SSP-RJ\",\n    \"notes\": \"Updated document information\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/person-documents/{{person_document_uuid}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "person-documents", "{{person_document_uuid}}"]
        }
      }
    },
    {
      "name": "Delete Persons Document (Soft)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "DELETE",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/person-documents/{{person_document_uuid}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "person-documents", "{{person_document_uuid}}"]
        }
      }
    },
    {
      "name": "Restore Persons Document",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "POST",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/person-documents/{{person_document_uuid}}/restore",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "person-documents", "{{person_document_uuid}}", "restore"]
        }
      }
    },
    {
      "name": "Force Delete Persons Document",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "DELETE",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/person-documents/{{person_document_uuid}}/force",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "person-documents", "{{person_document_uuid}}", "force"]
        }
      }
    }
  ],
  "variable": [
    {"key": "base_url", "value": "http://localhost:8000", "type": "string"},
    {"key": "person_document_uuid", "value": "", "type": "string"}
  ]
}
