          "raw": "{\n    \"ibge_id\": 310620005,\n    \"name\": \"Centro\",\n    \"name_en\": \"Downtown\",\n    \"city_id\": 1\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/districts",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "districts"]
        }
      }
    },
    {
