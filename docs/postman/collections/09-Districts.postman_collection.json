{
  "info": {
    "_postman_id": "districts-collection-v1",
    "name": "09 - Districts",
    "description": "Brazilian Districts management - Full CRUD operations",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "List Districts",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/districts?per_page=15",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "districts"],
          "query": [{"key": "per_page", "value": "15"}]
        }
      }
    },
    {
      "name": "Show District",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/districts/:uuid",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "districts", ":uuid"],
          "variable": [{"key": "uuid", "value": ""}]
        }
      }
    },
