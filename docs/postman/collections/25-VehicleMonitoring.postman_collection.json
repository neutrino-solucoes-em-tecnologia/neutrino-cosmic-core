{
	"info": {
		"_postman_id": "vehicle-monitoring-collection-v1",
		"name": "25 - Vehicle Monitoring",
		"description": "Vehicle Monitoring endpoints: List, Show, Create, Update, Delete, Restore, Force Delete",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "List All Vehicle Monitoring",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/v1/vehicle-monitoring?per_page=15&page=1&sort=-created_at",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "vehicle-monitoring"],
					"query": [
						{
							"key": "per_page",
							"value": "15",
							"description": "Items per page (1-100)"
						},
						{
							"key": "page",
							"value": "1",
							"description": "Page number"
						},
						{
							"key": "search",
							"value": "ABC1234",
							"description": "Search term (searches plate, chassis_number, owner_name)",
							"disabled": true
						},
						{
							"key": "sort",
							"value": "-created_at",
							"description": "Sort field (prefix with - for descending)"
						},
						{
							"key": "filter[status]",
							"value": "active",
							"description": "Filter by status (active, inactive, recovered, expired)",
							"disabled": true
						},
						{
							"key": "filter[is_recovered]",
							"value": "false",
							"description": "Filter by recovered status (true/false)",
							"disabled": true
						},
						{
							"key": "filter[is_global_alert]",
							"value": "true",
							"description": "Filter by global alert (true/false)",
							"disabled": true
						},
						{
							"key": "filter[client_id]",
							"value": "",
							"description": "Filter by client ID",
							"disabled": true
						},
						{
							"key": "filter[monitoring_type_id]",
							"value": "",
							"description": "Filter by monitoring type ID",
							"disabled": true
						}
					]
				},
				"description": "Retrieve a paginated list of vehicle monitoring records with optional filters, search, and sorting"
			},
			"response": []
		},
		{
			"name": "Show Vehicle Monitoring",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/v1/vehicle-monitoring/:uuid",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "vehicle-monitoring", ":uuid"],
					"variable": [
						{
							"key": "uuid",
							"value": "",
							"description": "Vehicle monitoring UUID"
						}
					]
				},
				"description": "Retrieve a single vehicle monitoring record by its UUID with related client, monitoring type, vehicle, and user data"
			},
			"response": []
		},
		{
			"name": "Create Vehicle Monitoring",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"client_id\": 1,\n  \"monitoring_type_id\": 1,\n  \"plate\": \"ABC1234\",\n  \"chassis_number\": \"9BWZZZ377VT004251\",\n  \"owner_name\": \"John Doe\",\n  \"contact_phone\": \"+55 11 99999-9999\",\n  \"stolen_at\": \"2025-01-15T10:30:00Z\",\n  \"valid_until\": \"2027-01-15T10:30:00Z\",\n  \"status\": \"active\",\n  \"is_verified\": true,\n  \"is_private\": false,\n  \"is_global_alert\": true,\n  \"alert_on_passage\": true,\n  \"observation\": \"Stolen from parking lot - high priority\",\n  \"custom_alert_message\": \"ALERT: Stolen vehicle detected - notify authorities immediately\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/api/v1/vehicle-monitoring",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "vehicle-monitoring"]
				},
				"description": "Create a new vehicle monitoring record. Validates against duplicate active monitoring for same plate and client."
			},
			"response": []
		},
		{
			"name": "Update Vehicle Monitoring",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"status\": \"recovered\",\n  \"is_recovered\": true,\n  \"recovered_at\": \"2025-01-16T14:20:00Z\",\n  \"observation\": \"Vehicle recovered by police - owner notified\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/api/v1/vehicle-monitoring/:uuid",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "vehicle-monitoring", ":uuid"],
					"variable": [
						{
							"key": "uuid",
							"value": "",
							"description": "Vehicle monitoring UUID"
						}
					]
				},
				"description": "Update an existing vehicle monitoring record. All fields are optional."
			},
			"response": []
		},
		{
			"name": "Delete Vehicle Monitoring (Soft)",
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/v1/vehicle-monitoring/:uuid",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "vehicle-monitoring", ":uuid"],
					"variable": [
						{
							"key": "uuid",
							"value": "",
							"description": "Vehicle monitoring UUID"
						}
					]
				},
				"description": "Soft delete a vehicle monitoring record. The record can be restored later."
			},
			"response": []
		},
		{
			"name": "Restore Vehicle Monitoring",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/v1/vehicle-monitoring/:uuid/restore",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "vehicle-monitoring", ":uuid", "restore"],
					"variable": [
						{
							"key": "uuid",
							"value": "",
							"description": "Vehicle monitoring UUID"
						}
					]
				},
				"description": "Restore a soft deleted vehicle monitoring record"
			},
			"response": []
		},
		{
			"name": "Force Delete Vehicle Monitoring",
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/v1/vehicle-monitoring/:uuid/force",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "vehicle-monitoring", ":uuid", "force"],
					"variable": [
						{
							"key": "uuid",
							"value": "",
							"description": "Vehicle monitoring UUID"
						}
					]
				},
				"description": "Permanently delete a vehicle monitoring record. This action cannot be undone."
			},
			"response": []
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					""
				]
			}
		}
	],
	"variable": []
