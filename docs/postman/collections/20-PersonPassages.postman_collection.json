              "description": "Filter by detection method: facial_recognition, document_scan, manual_entry"
            },
            {
              "key": "filter[first]",
              "value": "1",
              "description": "Filter first passages only (1=true, 0=false)"
            },
            {
              "key": "sort",
              "value": "-passed_at",
              "description": "Sort by field (prefix with - for descending)"
            }
          ]
        }
      },
