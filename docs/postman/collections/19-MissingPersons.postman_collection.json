{
  "info": {
    "_postman_id": "missing-persons-collection-v1",
    "name": "19 - Missing Persons",
    "description": "Missing Persons endpoints: List, Show, Create, Update, Delete, Restore, Force Delete",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "List All Missing Persons",
      "request": {
        "method": "GET",
        "header": [
          {"key": "Accept", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{auth_token}}"}
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/missing-persons?per_page=15&filter[case_status]=MISSING&filter[priority_level]=1&sort=-missing_since",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "missing-persons"],
          "query": [
            {"key": "per_page", "value": "15", "description": "Items per page (1-100)"},
            {"key": "search", "value": "downtown", "description": "Search in location, police report, notes", "disabled": true},
            {"key": "filter[person_id]", "value": "1", "description": "Filter by person ID", "disabled": true},
            {"key": "filter[case_status]", "value": "MISSING", "description": "MISSING, FOUND_ALIVE, FOUND_DECEASED, CLOSED"},
            {"key": "filter[priority_level]", "value": "1", "description": "Priority level (1-5)"},
            {"key": "sort", "value": "-missing_since", "description": "Sort by field (prefix - for desc)"}
          ]
        }
      },
      "response": []
    },
    {
      "name": "Show Missing Person",
      "request": {
        "method": "GET",
        "header": [
          {"key": "Accept", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{auth_token}}"}
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/missing-persons/{{missing_person_uuid}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "missing-persons", "{{missing_person_uuid}}"]
        }
      },
      "response": []
    },
    {
      "name": "Create Missing Person",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Accept", "value": "application/json"},
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{auth_token}}"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"person_id\": 1,\n  \"missing_since\": \"2026-01-20T15:30:00Z\",\n  \"last_seen_location\": \"Central Park, near fountain\",\n  \"last_seen_description\": \"Wearing blue jacket, seemed disoriented\",\n  \"last_seen_clothing\": \"Blue jacket, jeans, white sneakers\",\n  \"reporting_person_id\": 2,\n  \"reporting_person_relationship\": \"Mother\",\n  \"reporting_person_contact\": \"+55 11 98765-4321\",\n  \"police_report_number\": \"BO-2026-12345\",\n  \"police_station\": \"1st Police Station\",\n  \"police_report_date\": \"2026-01-20\",\n  \"case_status\": \"MISSING\",\n  \"case_notes\": \"Family is very concerned. Person has medical condition.\",\n  \"priority_level\": 1,\n  \"height\": 1.75,\n  \"weight\": 70.5,\n  \"hair_color\": \"Brown\",\n  \"eye_color\": \"Blue\",\n  \"physical_marks\": \"Scar on left arm\",\n  \"medical_conditions\": \"Diabetes - requires insulin\",\n  \"photo_url\": \"https://example.com/photos/person123.jpg\"\n}",
          "options": {"raw": {"language": "json"}}
        },
        "url": {
          "raw": "{{base_url}}/api/v1/missing-persons",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "missing-persons"]
        }
      },
      "response": []
    },
    {
      "name": "Update Missing Person",
      "request": {
        "method": "PUT",
        "header": [
          {"key": "Accept", "value": "application/json"},
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{auth_token}}"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"case_status\": \"FOUND_ALIVE\",\n  \"found_at\": \"2026-01-22T10:30:00Z\",\n  \"found_location\": \"Hospital Regional - Downtown\",\n  \"found_circumstances\": \"Person was found by police patrol near bus station. In good health.\",\n  \"priority_level\": 5,\n  \"case_notes\": \"Case resolved successfully. Person reunited with family.\"\n}",
          "options": {"raw": {"language": "json"}}
        },
        "url": {
          "raw": "{{base_url}}/api/v1/missing-persons/{{missing_person_uuid}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "missing-persons", "{{missing_person_uuid}}"]
        }
      },
      "response": []
    },
    {
      "name": "Delete Missing Person (Soft)",
      "request": {
        "method": "DELETE",
        "header": [
          {"key": "Accept", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{auth_token}}"}
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/missing-persons/{{missing_person_uuid}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "missing-persons", "{{missing_person_uuid}}"]
        }
      },
      "response": []
    },
    {
      "name": "Restore Missing Person",
      "request": {
        "method": "POST",
        "header": [
          {"key": "Accept", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{auth_token}}"}
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/missing-persons/{{missing_person_uuid}}/restore",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "missing-persons", "{{missing_person_uuid}}", "restore"]
        }
      },
      "response": []
    },
    {
      "name": "Force Delete Missing Person",
      "request": {
        "method": "DELETE",
        "header": [
          {"key": "Accept", "value": "application/json"},
          {"key": "Authorization", "value": "Bearer {{auth_token}}"}
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/missing-persons/{{missing_person_uuid}}/force",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "missing-persons", "{{missing_person_uuid}}", "force"]
        }
      },
      "response": []
    }
  ]
}