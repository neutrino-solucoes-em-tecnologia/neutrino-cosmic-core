					"mode": "raw",
					"raw": "{\n\t\"canonical_name\": \"stolen_vehicle\",\n\t\"display_name\": \"Stolen Vehicle\",\n\t\"description\": \"Vehicle reported as stolen\",\n\t\"severity\": \"critical\",\n\t\"requires_alert\": true,\n\t\"is_active\": true\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"description": "Create a new vehicle monitoring type.\n\n**Required fields:**\n- canonical_name: Unique identifier (lowercase, underscores)\n- display_name: Human-readable name\n- severity: One of: low, medium, high, critical\n\n**Optional fields:**\n- description: Detailed description\n- requires_alert: Boolean (default: false)\n- is_active: Boolean (default: true)"
			},
