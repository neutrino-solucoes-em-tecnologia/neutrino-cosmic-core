				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/v1/vehicle-whitelists/:uuid",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "vehicle-whitelists", ":uuid"],
					"variable": [
						{
							"key": "uuid",
							"value": "",
							"description": "Whitelist UUID"
						}
					]
				},
				"description": "Soft delete a vehicle whitelist (can be restored later)"
			},
			"response": []
		},
