{
	"info": {
		"_postman_id": "vehicle-whitelists-collection-v1",
		"name": "27 - Vehicle Whitelists",
		"description": "Vehicle Whitelist endpoints: List, Show, Create, Update, Delete, Restore, Force Delete",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "List All Whitelists",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/v1/vehicle-whitelists?per_page=15&page=1&sort=-created_at",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "vehicle-whitelists"],
					"query": [
						{
							"key": "per_page",
							"value": "15",
							"description": "Items per page (1-100)"
						},
						{
							"key": "page",
							"value": "1",
							"description": "Page number"
						},
						{
							"key": "search",
							"value": "VIP",
							"description": "Search term (observation)",
							"disabled": true
						},
						{
							"key": "sort",
							"value": "-created_at",
							"description": "Sort field (prefix with - for descending)"
						},
						{
							"key": "filter[uuid]",
							"value": "",
							"description": "Filter by UUID",
							"disabled": true
						},
						{
							"key": "filter[client_id]",
							"value": "1",
							"description": "Filter by client ID",
							"disabled": true
						},
						{
							"key": "filter[vehicle_id]",
							"value": "1",
							"description": "Filter by vehicle ID",
							"disabled": true
						},
						{
							"key": "filter[status]",
							"value": "active",
							"description": "Filter by status (active, inactive)",
							"disabled": true
						}
					]
				},
				"description": "Retrieve a paginated list of vehicle whitelists with optional filters"
			},
			"response": []
		},
		{
			"name": "Show Whitelist",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/v1/vehicle-whitelists/:uuid",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "vehicle-whitelists", ":uuid"],
					"variable": [
						{
							"key": "uuid",
							"value": "",
							"description": "Whitelist UUID"
						}
					]
				},
				"description": "Retrieve a single vehicle whitelist by UUID"
			},
			"response": []
		},
		{
			"name": "Create Whitelist",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}"
					},
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"client_id\": 1,\n  \"vehicle_id\": 1,\n  \"observation\": \"VIP client vehicle\",\n  \"status\": \"active\",\n  \"monitor_until\": \"2026-12-31 23:59:59\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/api/v1/vehicle-whitelists",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "vehicle-whitelists"]
				},
				"description": "Add a vehicle to client whitelist"
			},
			"response": []
		},
