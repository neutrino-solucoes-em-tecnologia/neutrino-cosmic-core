						"value": "Bearer {{auth_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/v1/vehicle-whitelists/:uuid/restore",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "vehicle-whitelists", ":uuid", "restore"],
					"variable": [
						{
							"key": "uuid",
							"value": "",
							"description": "Whitelist UUID"
						}
					]
				},
				"description": "Restore a soft deleted vehicle whitelist"
			},
			"response": []
		},
		{
			"name": "Force Delete Whitelist",
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{auth_token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/v1/vehicle-whitelists/:uuid/force",
					"host": ["{{base_url}}"],
					"path": ["api", "v1", "vehicle-whitelists", ":uuid", "force"],
					"variable": [
						{
							"key": "uuid",
							"value": "",
							"description": "Whitelist UUID"
						}
					]
				},
				"description": "Permanently delete a vehicle whitelist (cannot be undone)"
			},
			"response": []
		}
	],
