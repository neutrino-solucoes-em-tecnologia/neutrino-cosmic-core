{
  "info": {
    "_postman_id": "vehicle-types-collection-v1",
    "name": "21 - Vehicle Types",
    "description": "Vehicle type management endpoints - Full CRUD operations for vehicle categories (car, truck, motorcycle, bus, etc.)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "List Vehicle Types",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/vehicle-types?per_page=15&search=&sort=created_at",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "vehicle-types"],
          "query": [
            {"key": "per_page", "value": "15", "description": "Items per page (1-100)"},
            {"key": "page", "value": "1", "description": "Page number", "disabled": true},
            {"key": "search", "value": "", "description": "Search in canonical_name and display_name", "disabled": true},
            {"key": "sort", "value": "created_at", "description": "Sort field (created_at, updated_at, canonical_name, display_name)", "disabled": true},
            {"key": "filter[uuid]", "value": "", "description": "Filter by UUID", "disabled": true},
            {"key": "filter[canonical_name]", "value": "", "description": "Filter by canonical name", "disabled": true}
          ]
        },
        "description": "Retrieve a paginated list of vehicle types with optional filters and sorting."
      },
      "response": []
    },
    {
      "name": "Show Vehicle Type",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/vehicle-types/:uuid",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "vehicle-types", ":uuid"],
          "variable": [{"key": "uuid", "value": "", "description": "Vehicle Type UUID"}]
        },
        "description": "Retrieve a single vehicle type by its UUID."
      },
      "response": []
    },
    {
      "name": "Create Vehicle Type",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "POST",
        "header": [
          {"key": "Accept", "value": "application/json"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"canonical_name\": \"car\",\n    \"display_name\": \"Car\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/v1/vehicle-types",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "vehicle-types"]
        },
        "description": "Create a new vehicle type.\n\nRequired fields:\n- canonical_name: Normalized type name (lowercase, no accents)\n\nOptional fields:\n- display_name: User-friendly type name for display"
      },
      "response": []
    },
    {
      "name": "Update Vehicle Type",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "PUT",
        "header": [
          {"key": "Accept", "value": "application/json"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"canonical_name\": \"automobile\",\n    \"display_name\": \"Automobile\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/v1/vehicle-types/:uuid",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "vehicle-types", ":uuid"],
          "variable": [{"key": "uuid", "value": "", "description": "Vehicle Type UUID"}]
        },
        "description": "Update an existing vehicle type. All fields are optional (partial update supported)."
      },
      "response": []
    },
    {
      "name": "Delete Vehicle Type (Soft)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "DELETE",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/vehicle-types/:uuid",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "vehicle-types", ":uuid"],
          "variable": [{"key": "uuid", "value": "", "description": "Vehicle Type UUID"}]
        },
        "description": "Soft delete a vehicle type. Can be restored later. Prevents deletion if the type is currently in use by vehicles."
      },
      "response": []
    },
    {
      "name": "Restore Vehicle Type",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "POST",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/vehicle-types/:uuid/restore",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "vehicle-types", ":uuid", "restore"],
          "variable": [{"key": "uuid", "value": "", "description": "Vehicle Type UUID"}]
        },
        "description": "Restore a soft-deleted vehicle type."
      },
      "response": []
    },
    {
      "name": "Force Delete Vehicle Type",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "DELETE",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/vehicle-types/:uuid/force",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "vehicle-types", ":uuid", "force"],
          "variable": [{"key": "uuid", "value": "", "description": "Vehicle Type UUID"}]
        },
        "description": "Permanently delete a vehicle type. Cannot be undone. Prevents deletion if the type is in use by any vehicles (including soft-deleted)."
      },
      "response": []
    }
  ],
  "variable": [
    {"key": "base_url", "value": "http://localhost:8000", "type": "string"}
  ]
}
