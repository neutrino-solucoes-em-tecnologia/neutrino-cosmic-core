{
  "info": {
    "_postman_id": "healthcheck-collection-v1",
    "name": "11 - Health Check",
    "description": "Health check endpoints for Kubernetes monitoring",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check (Complete)",
      "request": {
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/health",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "health"]
        },
        "description": "Complete health check - DB, MongoDB, Redis, Queue"
      }
    },
    {
      "name": "Readiness Probe",
      "request": {
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/ready",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "ready"]
        },
        "description": "Kubernetes readiness probe - Service ready for traffic"
      }
    },
    {
      "name": "Liveness Probe",
      "request": {
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/live",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "live"]
        },
        "description": "Kubernetes liveness probe - Process is running"
      }
    }
  ],
  "variable": [
    {"key": "base_url", "value": "http://localhost:8000", "type": "string"}
  ]
}
