{
  "info": {
    "_postman_id": "cities-collection-v1",
    "name": "08 - Cities",
    "description": "Brazilian Cities (Municipalities) management - Full CRUD operations",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "List Cities",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/cities?per_page=15",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "cities"],
          "query": [{"key": "per_page", "value": "15"}]
        }
      }
    },
    {
      "name": "Show City",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "GET",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/cities/:uuid",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "cities", ":uuid"],
          "variable": [{"key": "uuid", "value": ""}]
        }
      }
    },
    {
      "name": "Create City",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "POST",
        "header": [
          {"key": "Accept", "value": "application/json"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"ibge_id\": 3550308,\n    \"name\": \"São Paulo\",\n    \"name_en\": \"Sao Paulo\",\n    \"microregion_id\": 1\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/cities",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "cities"]
        }
      }
    },
    {
      "name": "Update City",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "PUT",
        "header": [
          {"key": "Accept", "value": "application/json"},
          {"key": "Content-Type", "value": "application/json"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Updated Name\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/cities/:uuid",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "cities", ":uuid"],
          "variable": [{"key": "uuid", "value": ""}]
        }
      }
    },
    {
