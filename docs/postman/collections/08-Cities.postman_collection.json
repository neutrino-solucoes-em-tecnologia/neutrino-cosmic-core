    {
      "name": "Force Delete City",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{"key": "token", "value": "{{auth_token}}", "type": "string"}]
        },
        "method": "DELETE",
        "header": [{"key": "Accept", "value": "application/json"}],
        "url": {
          "raw": "{{base_url}}/api/v1/cities/:uuid/force",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "cities", ":uuid", "force"],
          "variable": [{"key": "uuid", "value": ""}]
